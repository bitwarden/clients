# Copy to `.env` and fill in. Values are layered lowest to highest precedence:
# `.env` (shared defaults) < `.env.${ENV}` (per-environment, e.g. `.env.qa`)

# Environment to target — selects which per-environment file (`.env.${ENV}`) is layered on top.
# development (default), qa, ... Set it here to pin a default, or override per run:
# `ENV=qa npm run test:e2e:browser`.
ENV=

# The server the extension is pointed at (entered into the login environment selector as a
# self-hosted URL). Defaults to the local dev server.
BW_SERVER_URL=

# Test account credentials, must already exist on BW_SERVER_URL.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Comma-separated Nx build-configuration names to run. Defaults to "chrome-dev". The browser to
# launch (chrome, edge, firefox). Reaches any configuration in apps/browser/project.json, e.g.
# edge-dev, chrome (prod), firefox-mv2-dev, commercial-chrome.
# e.g. TARGETS=chrome-dev,edge-dev,firefox-dev
TARGETS=

# Runs HEADED by default: headless Chrome does not fully start the extension's MV3 background
# service worker, so the popup never finishes loading. Only set HEADLESS=true to experiment.
HEADLESS=
