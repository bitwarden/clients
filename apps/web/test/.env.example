# Copy to `.env` and fill in. Values are layered lowest to highest precedence:
# `.env` (shared defaults) < `.env.${ENV}` (per-environment, e.g. `.env.qa`). Real shell/CI
# env vars override both. Only this `.env.example` is committed; every other `.env*` file
# is gitignored.

# Environment to target. Reuses the web app's build `ENV` (apps/web/config/${ENV}.json):
# development (default), usdev, qa, usqa2, euqa, ... The vault URL is resolved from that
# config, so switching ENV changes both the target URL and (via `.env.${ENV}`) the secrets.
# Set it here to pin a default, or override per run: `ENV=qa npm run test:e2e:web`.
ENV=

# Basic auth SeederApi Credentials
SEEDER_API_USERNAME=
SEEDER_API_PASSWORD=

# If Email and Password are supplied, SeederApi is disabled
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Comma-separated browsers to run. Defaults to "chrome". Supported: chrome, firefox, edge,
# safari (safari is macOS-only, always runs headed).
# e.g. BROWSERS=chrome,firefox,safari
BROWSERS=

# Headless, defaults True
HEADLESS=
