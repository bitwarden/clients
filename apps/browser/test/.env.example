# Copy to `.env` and fill in. Values layer lowest -> highest: `.env` (shared defaults) then
# `.env.${ENV}` (per-environment, e.g. `.env.qa`). Real shell/CI env vars override both. Only this
# `.env.example` is committed; every other `.env*` file is gitignored.

# Environment to target — selects which per-environment file (`.env.${ENV}`) is layered on top.
# development (default), qa, ... Override per run: `ENV=qa npm run test:e2e:browser`.
ENV=

# The server the extension is pointed at (entered into the login environment selector as a
# self-hosted URL). Defaults to the local dev server. Needs a full backend reachable there
# (/api, /identity, ...). For the cloud QA environment use https://vault.usqa.bitwarden.pw.
BW_SERVER_URL=https://localhost:8080

# Test account credentials — must already exist on BW_SERVER_URL.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Comma-separated Nx build-configuration name(s) to build and run. Defaults to "chrome-dev".
# Playwright loads extensions into Chromium only, so this must be a Chrome configuration
# (e.g. chrome-dev, commercial-chrome-dev).
TARGETS=

# Skip the globalSetup extension build (when building separately). Default false.
SKIP_BUILD=

# Runs HEADED by default: headless Chrome does not fully start the extension's MV3 background
# service worker, so the popup never finishes loading. Only set HEADLESS=true to experiment.
HEADLESS=
