{
  "name": "performance-tracking",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/performance-tracking/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/performance-tracking",
        "main": "libs/performance-tracking/src/index.ts",
        "tsConfig": "libs/performance-tracking/tsconfig.lib.json",
        "assets": ["libs/performance-tracking/*.md"],
        "rootDir": "libs/performance-tracking/src"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/performance-tracking/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/performance-tracking/jest.config.js"
      }
    }
  }
}
