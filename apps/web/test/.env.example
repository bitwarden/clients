# Copy to `.env` and fill in. Values layer lowest -> highest: `.env` (shared defaults) then
# `.env.${ENV}` (per-environment, e.g. `.env.qa`). Real shell/CI env vars override both. Only this
# `.env.example` is committed; every other `.env*` file is gitignored.

# Environment to target — selects which per-environment file (`.env.${ENV}`) is layered on top.
# development (default), qa, ... Set it here to pin a default, or override per run:
# `ENV=qa npm run test:e2e:web`.
ENV=

# Target web vault URL. Defaults to https://localhost:8080 (falls back to BW_SERVER_URL if set).
WEB_SERVER_BASE_URL=

# Build and serve the local dev server before running (apps/web `build:bit:watch`). Default false:
# the suite targets an already-running server at WEB_SERVER_BASE_URL.
START_WEB_SERVER=

# Test account credentials — must already exist on the target server.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Headless. Defaults to true; set HEADLESS=false to watch the run.
HEADLESS=
