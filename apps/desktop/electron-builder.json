{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "extraMetadata": {
    "name": "bitwarden"
  },
  "productName": "Bitwarden",
  "appId": "com.bitwarden.desktop",
  "buildDependenciesFromSource": true,
  "copyright": "Copyright © 2015-2026 Bitwarden Inc.",
  "directories": {
    "buildResources": "resources",
    "output": "dist",
    "app": "build"
  },
  "afterSign": "scripts/after-sign.js",
  "afterPack": "scripts/after-pack.js",
  "beforePack": "scripts/before-pack.js",
  "appxManifestCreated": "scripts/appx-manifest-created.js",
  "files": [
    "!node_modules/@bitwarden/desktop-napi/scripts",
    "!node_modules/@bitwarden/desktop-napi/src",
    "!node_modules/@bitwarden/desktop-napi/Cargo.toml",
    "!node_modules/@bitwarden/desktop-napi/build.rs",
    "!node_modules/@bitwarden/desktop-napi/package.json"
  ],
  "electronVersion": "45.2.3",
  "generateUpdatesFilesForAllChannels": true,
  "publish": {
    "provider": "generic",
    "url": "https://artifacts.bitwarden.com/desktop"
  },
  "mac": {
    "electronUpdaterCompatibility": ">=0.0.1",
    "category": "public.app-category.productivity",
    "darkModeSupport": true,
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
    "extendInfo": {
      "BitwardenAppGroupIdentifier": "LTZ2PFU5D6.com.bitwarden.desktop",
      "ITSAppUsesNonExemptEncryption": false,
      "CFBundleLocalizations": [
        "en",
        "cs",
        "da",
        "de",
        "es",
        "et",
        "fi",
        "fr",
        "hr",
        "hu",
        "id",
        "it",
        "ja",
        "nb",
        "nl",
        "pl",
        "pt-BR",
        "pt-PT",
        "ro",
        "ru",
        "sk",
        "sv",
        "tr",
        "uk",
        "vi",
        "zh-Hans",
        "zh-Hant"
      ],
      "CFBundleDevelopmentRegion": "en"
    },
    "provisioningProfile": "bitwarden_stable_desktop_developer_id.provisionprofile",
    "singleArchFiles": "node_modules/@bitwarden/desktop-napi/desktop_napi.darwin-*.node",
    "x64ArchFiles": "{**/desktop_napi.darwin-*.node,**/bufferutil/**/darwin-*/*.node}",
    "extraFiles": [
      {
        "from": "desktop_native/dist/desktop_proxy.${platform}-${arch}",
        "to": "MacOS/desktop_proxy"
      },
      {
        "from": "desktop_native/dist/desktop_proxy.${platform}-${arch}",
        "to": "MacOS/desktop_proxy.inherit"
      }
    ],
    "signIgnore": [
      "MacOS/desktop_proxy",
      "MacOS/desktop_proxy.inherit",
      "Contents/PlugIns/autofill-extension.appex",
      "Frameworks/Electron Framework.framework/(Electron Framework|Libraries|Resources|Versions/Current)/.*"
    ],
    "target": ["dmg", "zip"]
  },
  "win": {
    "electronUpdaterCompatibility": ">=0.0.1",
    "target": ["portable", "nsis-web", "appx"],
    "signExts": [".dll", ".node"],
    "signtoolOptions": {
      "sign": "./sign.js",
      "publisherName": "Bitwarden Inc."
    },
    "extraFiles": [
      {
        "from": "desktop_native/dist/desktop_proxy.win32-${arch}.exe",
        "to": "desktop_proxy.exe"
      },
      {
        "from": "desktop_native/dist/bitwarden_chromium_import_helper.win32-${arch}.exe",
        "to": "bitwarden_chromium_import_helper.exe"
      },
      {
        "from": "desktop_native/dist/windows_plugin_authenticator.win32-${arch}.exe",
        "to": "bitwarden_plugin_authenticator.exe"
      }
    ],
    "extraResources": [
      {
        "from": "resources/windows_plugin_authenticator_config.stable.json",
        "to": "plugin_authenticator_config.json"
      },
      {
        "from": "resources/windows_plugin_authenticator_logo_light.stable.svg",
        "to": "plugin_authenticator_logo_light.svg"
      },
      {
        "from": "resources/windows_plugin_authenticator_logo_dark.stable.svg",
        "to": "plugin_authenticator_logo_dark.svg"
      }
    ]
  },
  "linux": {
    "category": "Utility",
    "synopsis": "A secure and free password manager for all of your devices.",
    "extraFiles": [
      {
        "from": "desktop_native/dist/desktop_proxy.${platform}-${arch}",
        "to": "desktop_proxy"
      },
      {
        "from": "desktop_native/dist/libprocess_isolation.so",
        "to": "libprocess_isolation.so"
      }
    ],
    "target": ["deb", "rpm", "AppImage", "snap"],
    "desktop": {
      "entry": {
        "Name": "Bitwarden",
        "Type": "Application",
        "GenericName": "Password Manager"
      }
    }
  },
  "dmg": {
    "icon": "dmg.icns",
    "background": "resources/background.png",
    "sign": false,
    "contents": [
      {
        "x": 150,
        "y": 185,
        "type": "file"
      },
      {
        "x": 390,
        "y": 180,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "mas": {
    "identity": "Bitwarden Inc",
    "entitlements": "resources/entitlements.mas.plist",
    "entitlementsInherit": "resources/entitlements.mas.inherit.plist",
    "entitlementsLoginHelper": "resources/entitlements.mas.loginhelper.plist",
    "hardenedRuntime": true,
    "extendInfo": {
      "LSMinimumSystemVersion": "12",
      "ElectronTeamID": "LTZ2PFU5D6"
    },
    "provisioningProfile": "bitwarden_stable_desktop_appstore.provisionprofile"
  },
  "nsisWeb": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "artifactName": "${productName}-Installer-${version}.${ext}",
    "uninstallDisplayName": "${productName}",
    "deleteAppDataOnUninstall": true,
    "include": "installer.nsh"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  },
  "appx": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "backgroundColor": "#175DDC",
    "applicationId": "bitwardendesktop",
    "identityName": "8bitSolutionsLLC.bitwardendesktop",
    "publisher": "CN=14D52771-DE3C-4886-B8BF-825BA7690418",
    "minVersion": "10.0.14393.0",
    "maxVersionTested": "10.0.26100.0",
    "customExtensionsPath": "../custom-appx-extensions.stable.xml",
    "publisherDisplayName": "Bitwarden Inc",
    "languages": [
      "en-US",
      "af",
      "ar",
      "az-latn",
      "be",
      "bg",
      "bn",
      "bs",
      "ca",
      "cs",
      "cy",
      "da",
      "de",
      "el",
      "en-gb",
      "en-in",
      "es",
      "et",
      "eu",
      "fa",
      "fi",
      "fil",
      "fr",
      "gl",
      "he",
      "hi",
      "hr",
      "hu",
      "id",
      "it",
      "ja",
      "ka",
      "km",
      "kn",
      "ko",
      "lt",
      "lv",
      "ml",
      "mr",
      "nb",
      "ne",
      "nl",
      "nn",
      "or",
      "pl",
      "pt-br",
      "pt-pt",
      "ro",
      "ru",
      "si",
      "sk",
      "sl",
      "sr-cyrl",
      "sv",
      "ta",
      "te",
      "th",
      "tr",
      "uk",
      "vi",
      "zh-cn",
      "zh-tw"
    ]
  },
  "deb": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "depends": ["libnotify4", "libxtst6", "libnss3", "libxss1"]
  },
  "appImage": {
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "rpm": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "fpm": ["--rpm-rpmbuild-define", "_build_id_links none"]
  },
  "snap": {
    "title": "Bitwarden Password Manager",
    "summary": "Securely store, share, and autofill passwords and passkeys anywhere.",
    "description": "Bitwarden is the trusted open source password manager used by millions to secure their accounts from hackers and data breaches. Generate, save, and autofill strong passwords for every account on every device.\n\nRecognized by PCMag, WIRED, The Verge, CNET, G2, and more!\n\nAUTOFILL EVERYTHING INSTANTLY\nNever forget a password again. Autofill logins from anywhere, on any device.\n\nEASILY GENERATE STRONG PASSWORDS\nProtect all accounts with long, complex, and unique passwords. Generate usernames and email aliases for added security.\n\nA SECURE VAULT FOR SENSITIVE INFORMATION\nKeep passkeys, payment cards, secure notes, identities, and more in the end-to-end encrypted vault that syncs everywhere.\n\nSYNC PASSKEYS SECURELY\nCreate and store passkeys for your logins that you can use across your devices, regardless of browser, mobile device, or computer OS.\n\nSHARE PASSWORDS SAFELY\nShare logins with family or friends in a shared vault or use a secure link to directly share encrypted text, or vault items and files with Premium, with strong security controls.\n\nACCESS FROM ANY DEVICE\nUse Bitwarden on your phone, tablet, and computer, in every major browser. Store unlimited passwords and sync across unlimited devices.\n\nSECURITY YOU CAN VERIFY\nBitwarden codebase is open source, meaning it can be viewed by anyone to ensure it functions securely. Third-party security audits are published annually. There’s nothing to hide.\n\nINDIVIDUALS AND FAMILIES\nBitwarden offers plans for everyone, even a basic free plan. Premium plans have even more features to make security easier, and a Families plan gives six users premium features and a shared vault.\n\nTEAMS AND ENTERPRISE\nBitwarden secures businesses around the world. Features like Login with SSO, role-based access controls, SCIM provisioning, enterprise policies, reporting, and centralized ownership secure organizations of any size.\n\nMORE FROM BITWARDEN\nFor developers and DevOps, Bitwarden Secrets Manager secures dev secrets, AI agents, and machine accounts and integrates with Bitwarden Password Manager.\n\nBitwarden requires access to the `password-manager-service` for secure storage. Please enable it through permissions or by running `sudo snap connect bitwarden:password-manager-service`. If you were already logged in, log out and log back in.",
    "autoStart": true,
    "base": "core22",
    "confinement": "strict",
    "plugs": [
      "default",
      "network-bind",
      "password-manager-service",
      {
        "polkit": {
          "action-prefix": "com.bitwarden.Bitwarden"
        }
      },
      {
        "dot-native-messaging": {
          "interface": "personal-files",
          "read": [],
          "write": [
            "$HOME/.config/chromium/NativeMessagingHosts",
            "$HOME/.config/microsoft-edge/NativeMessagingHosts",
            "$HOME/.config/google-chrome/NativeMessagingHosts",
            "$HOME/.mozilla/native-messaging-hosts"
          ]
        }
      },
      "u2f-devices",
      "hardware-observe"
    ],
    "stagePackages": ["default"],
    "allowNativeWayland": true
  },
  "protocols": [
    {
      "name": "Bitwarden",
      "schemes": ["bitwarden"]
    }
  ]
}
